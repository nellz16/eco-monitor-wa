# HTTP server
PORT=8080

# SQLite session store. On Koyeb Free this is ephemeral local storage.
DATA_DIR=./data

# Generate a random secret of at least 32 characters.
API_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# Use international format digits only (Indonesia example: 628xxxxxxxxxx).
# Messages can only be sent to recipients listed here.
ALLOWED_RECIPIENTS=6281234567890
DEFAULT_RECIPIENT=6281234567890

# Optional browser CORS allowlist. Vercel serverless proxy does not require CORS.
ALLOWED_ORIGINS=https://your-dashboard.vercel.app,http://localhost:5173

# Prevent repeated message sends. Default: 20 seconds.
MIN_SEND_INTERVAL_SECONDS=20
